{
    "name": "nextjs-watch-store",
    "version": "0.1.0",
    "private": false,
    "scripts": {
        "dev": "next dev",
        "build": "prisma generate && next build",
        "start": "next start",
        "lint": "eslint .",
        "test": "vitest",
        "test:run": "vitest run",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "prepare": "husky",
        "typecheck": "tsc --noEmit",
        "verify": "pnpm typecheck && pnpm exec eslint . && pnpm exec prettier --check . && pnpm test:run"
    },
    "type": "module",
    "lint-staged": {
        "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
            "prettier --write",
            "eslint --fix"
        ],
        "*.{json,jsonc,md,mdx,css,scss,html,yml,yaml}": "prettier --write"
    },
    "dependencies": {
        "@base-ui/react": "1.9.0",
        "@bprogress/next": "3.2.12",
        "@hookform/resolvers": "6.0.0",
        "@prisma/adapter-pg": "7.10.1",
        "@prisma/client": "7.10.1",
        "bcryptjs": "3.0.3",
        "better-auth": "1.7.12",
        "clsx": "2.1.1",
        "dotenv": "18.0.8",
        "lucide-react": "1.59.0",
        "next": "16.4.2",
        "next-themes": "0.4.6",
        "pg": "8.23.1",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-hook-form": "7.90.0",
        "swiper": "14.3.0",
        "tailwind-merge": "3.7.0",
        "valibot": "1.5.0"
    },
    "devDependencies": {
        "@chromatic-com/storybook": "latest",
        "@fullstacksjs/eslint-config": "15.4.0",
        "@storybook/addon-a11y": "10.6.7",
        "@storybook/addon-docs": "10.6.7",
        "@storybook/addon-onboarding": "10.6.7",
        "@storybook/addon-vitest": "10.6.7",
        "@storybook/nextjs-vite": "10.6.7",
        "@tailwindcss/turbopack": "4.3.3",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.12",
        "@types/node": "20.19.43",
        "@types/pg": "8.23.1",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.3.0",
        "@vitest/browser-playwright": "5.1.0",
        "@vitest/coverage-v8": "5.1.0",
        "babel-plugin-react-compiler": "1.0.0",
        "eslint": "10.13.0",
        "husky": "9.1.7",
        "jsdom": "31.0.1",
        "lint-staged": "17.6.1",
        "playwright": "latest",
        "prettier": "3.9.10",
        "prettier-plugin-tailwindcss": "0.8.1",
        "prisma": "7.10.1",
        "storybook": "10.6.7",
        "tailwindcss": "4.3.3",
        "tsx": "4.23.15",
        "typescript": "5.9.3",
        "vite": "8.3.8",
        "vite-tsconfig-paths": "6.1.1",
        "vitest": "5.1.0"
    },
    "packageManager": "pnpm@11.17.0"
}
